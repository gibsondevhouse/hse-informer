{
  "realm": "hse-dev",
  "displayName": "HSE Informer development",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "clients": [
    {
      "clientId": "hse-web",
      "name": "HSE Informer SvelteKit",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${HSE_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/auth/callback"],
      "webOrigins": ["http://localhost:5173"]
    }
  ],
  "roles": {
    "realm": [
      {"name": "hse_admin"},
      {"name": "hse_evaluator"},
      {"name": "hse_learner"}
    ]
  },
  "groups": [
    {"name": "company-a", "subGroups": [{"name": "tifton"}, {"name": "ocilla"}, {"name": "vernon"}]},
    {"name": "company-b", "subGroups": [{"name": "pilot"}]}
  ],
  "users": [
    {
      "id": "33333333-3333-4333-8333-333333333333",
      "username": "synthetic.admin.a",
      "email": "admin.a@example.invalid",
      "firstName": "Synthetic",
      "lastName": "Admin A",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/company-a"],
      "realmRoles": ["hse_admin"],
      "credentials": [{"type": "password", "value": "${DEV_WORKER_PASSWORD}", "temporary": false}]
    },
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "synthetic.worker.a",
      "email": "worker.a@example.invalid",
      "firstName": "Synthetic",
      "lastName": "Worker A",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/company-a/tifton"],
      "realmRoles": ["hse_learner"],
      "credentials": [{"type": "password", "value": "${DEV_WORKER_PASSWORD}", "temporary": false}]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "synthetic.worker.b",
      "email": "worker.b@example.invalid",
      "firstName": "Synthetic",
      "lastName": "Worker B",
      "enabled": true,
      "emailVerified": true,
      "groups": ["/company-b/pilot"],
      "realmRoles": ["hse_learner"],
      "credentials": [{"type": "password", "value": "${DEV_WORKER_PASSWORD}", "temporary": false}]
    }
  ]
}
