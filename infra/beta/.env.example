# Supply these from the host secret manager. Never commit the populated file.
BETA_IMAGE_REPOSITORY=registry.example.invalid/hse-informer
BETA_IMAGE_TAG=replace-with-reviewed-git-sha
BETA_HTTP_PORT=3000
DATABASE_URL=postgres://hse_app:replace@db.example.invalid/hse_beta?sslmode=require
APP_ORIGIN=https://hse-beta.example.invalid
OIDC_ISSUER=https://identity.example.invalid/realms/hse-beta
OIDC_CLIENT_ID=hse-beta
OIDC_CLIENT_SECRET=replace-with-secret-manager-value
KEYCLOAK_ADMIN_CLIENT_ID=hse-account-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-secret-manager-value
SESSION_SECRET=replace-with-at-least-32-random-bytes
MOODLE_CONNECTIONS_JSON={"tenant-uuid":{"instanceId":"stable-instance-uuid","baseUrl":"https://moodle-beta.example.invalid","token":"replace-with-service-token","learnerRoleId":5,"authMethod":"oauth2","oauthIssuerId":1,"oauthBridgeToken":"replace-with-dedicated-bridge-token","completionEvidence":"local_hse_evidence"}}
ALERT_WEBHOOK_URL=https://alerts.example.invalid/hse-beta
ALERT_OWNER=replace-with-named-person-and-escalation-contact
BETA_JOB_INTERVAL_SECONDS=300
