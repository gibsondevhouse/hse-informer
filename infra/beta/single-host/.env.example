# Prefer prepare.py create to generate every secret in one private file outside Git.
BETA_IMAGE_REPOSITORY=hse-beta/app
BETA_IMAGE_TAG=
APP_HOST=
AUTH_HOST=
COURSES_HOST=
ADMIN_EMAIL=
POSTGRES_ADMIN_PASSWORD=
HSE_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MOODLE_DB_PASSWORD=
HSE_OIDC_CLIENT_SECRET=
HSE_ADMIN_CLIENT_SECRET=
MOODLE_OIDC_CLIENT_SECRET=
SESSION_SECRET=
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=
MOODLE_ADMIN_USER=
MOODLE_ADMIN_PASSWORD=
MOODLE_SITE_FULLNAME=
MOODLE_SITE_SHORTNAME=
MOODLE_INSTANCE_ID=
# Fill these together after tenant bootstrap and restricted Moodle service setup.
HSE_TENANT_ID=
MOODLE_SERVICE_TOKEN=
MOODLE_OAUTH_ISSUER_ID=
MOODLE_OAUTH_BRIDGE_TOKEN=
# Email delivery is needed for the initial administrator bootstrap.
# SMTP_FROM is required for realm startup; prepare.py defaults it to ADMIN_EMAIL.
# The mail provider may require a different verified sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
ALERT_OWNER=
ALERT_WEBHOOK_URL=
BETA_JOB_INTERVAL_SECONDS=300
AGE_RECIPIENT=
