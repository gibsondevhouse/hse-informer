# Development-only values. Copy to infra/.env and replace before starting Compose.
# Never use these example values for a reachable or production deployment.
HSE_DB_PASSWORD=dev-only-hse-db-password
KEYCLOAK_DB_PASSWORD=dev-only-keycloak-db-password
MOODLE_A_DB_PASSWORD=dev-only-moodle-a-db-password
MOODLE_B_DB_PASSWORD=dev-only-moodle-b-db-password
KEYCLOAK_ADMIN_PASSWORD=dev-only-keycloak-admin-password
MOODLE_ADMIN_PASSWORD=dev-only-moodle-admin-password
HSE_OIDC_CLIENT_SECRET=dev-only-hse-oidc-secret
MOODLE_A_OIDC_CLIENT_SECRET=dev-only-moodle-a-oidc-secret
MOODLE_B_OIDC_CLIENT_SECRET=dev-only-moodle-b-oidc-secret
DEV_WORKER_PASSWORD=dev-only-worker-password
