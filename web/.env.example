# Never use production data with the synthetic seed or DEV_AUTH.
DATABASE_URL=postgres://hse_app:change-me@localhost:5432/hse_informer
APP_ORIGIN=http://localhost:5173
OIDC_ISSUER=http://auth.localhost:8080/realms/hse-dev
OIDC_CLIENT_ID=hse-web
OIDC_CLIENT_SECRET=change-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Only permitted with NODE_ENV !== production and seeded synthetic data.
DEV_AUTH=
# JSON keyed by tenant UUID. instanceId is a stable UUID independent of the Moodle URL:
# {"tenant-uuid":{"instanceId":"instance-uuid","baseUrl":"https://moodle.example","token":"...","learnerRoleId":5,"authMethod":"verified_auth_plugin_id"}}
MOODLE_CONNECTIONS_JSON={}
# Optional for the integration test suite.
TEST_DATABASE_URL=
