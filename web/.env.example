# Never use production data with the synthetic seed or DEV_AUTH.
DATABASE_URL=postgres://hse_app:change-me@localhost:5432/hse_informer
APP_ORIGIN=http://localhost:5173
OIDC_ISSUER=https://auth.localhost:8443/realms/hse-dev
OIDC_CLIENT_ID=hse-web
OIDC_CLIENT_SECRET=change-me
# Server-only Keycloak service client with manage-users, view-users, query-users.
KEYCLOAK_ADMIN_CLIENT_ID=hse-account-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Only permitted with NODE_ENV !== production and seeded synthetic data.
DEV_AUTH=
# JSON keyed by tenant UUID. instanceId is a stable UUID independent of the Moodle URL:
# {"tenant-uuid":{"instanceId":"instance-uuid","baseUrl":"https://moodle.example","token":"...","learnerRoleId":5,"authMethod":"oauth2","oauthIssuerId":3,"oauthBridgeToken":"separate-restricted-token","completionEvidence":"local_hse_evidence"}}
MOODLE_CONNECTIONS_JSON={}
# Optional for the integration test suite.
TEST_DATABASE_URL=
